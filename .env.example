# NEXUS Platform Environment Variables (100% Free & Local Mode)

# App Config
PORT=3000
NODE_ENV=development
VITE_APP_NAME="NEXUS Context Twin"

# Security & Local Encryption (Zero-Knowledge AES-256 Secret)
ENCRYPTION_SECRET=nexus_zero_knowledge_master_secret_aes256_key_32bytes!
NEXTAUTH_SECRET=nexus_nextauth_jwt_super_secret_session_key_2026!
NEXTAUTH_URL=http://localhost:3000

# Real Gmail SMTP OTP Delivery Setup (أدخِل حساب الجيميل وكلمة مرور التطبيقات App Password لإرسال الـ OTP فعلياً)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM="NEXUS Context Platform" <your_gmail_address@gmail.com>

# Optional Server Features
# GEMINI_API_KEY=your_gemini_api_key_here


